{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin ui-dev:*)",
      "Bash(git push -q origin ui-dev:*)",
      "Bash(git push -u origin ui-dev:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); case \"$cmd\" in *' build'*) \"$CLAUDE_PROJECT_DIR\"/scripts/zig-cache-prune.sh --quiet ;; esac",
            "timeout": 900,
            "statusMessage": "Checking the Zig build cache's size"
          }
        ]
      }
    ]
  }
}
