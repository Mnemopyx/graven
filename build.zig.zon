.{
    .name = .graven,
    .version = "0.0.0",
    .fingerprint = 0x46477ad73823d04c,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // HarfBuzz 15.1.0 (tag 15.1.0, commit 3df40d9b98d6b32f0e4288d4ecfbb158ddb3a372).
