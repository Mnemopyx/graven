            .url = "https://github.com/Mnemopyx/graven/releases/download/occt-8.0.1-x86_64-linux-gnu-zig0.17.0-47050a1a/occt-8.0.1-x86_64-linux-gnu-zig0.17.0-47050a1a.tar.xz",
